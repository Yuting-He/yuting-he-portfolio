{
  "name": "yuting-he-portfolio",
  "version": "0.8.0",
  "private": true,
  "description": "Portfolio and HeatLens Germany observed, probabilistic, role-specific heat and soil-water decision-support application.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Yuting-He/yuting-he-portfolio.git"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "serve": "node ./scripts/serve.mjs",
    "serve:live": "npm run refresh-data && npm run build-assets && npm run serve",
    "refresh-data": "node ./scripts/fetch-live-data.mjs",
    "build-assets": "node ./scripts/build-heatlens-assets.mjs",
    "test": "node --test ./tests/*.test.mjs",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "h5wasm": "^0.10.3",
    "proj4": "^2.19.10"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1"
  }
}
